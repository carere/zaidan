{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@biomejs/biome", "@moonrepo/cli"]
    },
    "apps/website": {
      "entry": [
        "src/pages/**/*.mdx",
        "src/registry/kobalte/examples/**/*.tsx",
        "velite.config.ts",
        "tests/browser/*.fixture.tsx",
        "tests/browser/vite.config.ts"
      ],
      "ignoreIssues": {
        ".velite/**": ["files", "exports", "types"],
        "src/lib/types.ts": ["duplicates"],
        "src/registry/kobalte/**": ["files", "exports", "types"]
      }
    },
    "apps/factory": {
      "entry": [
        "src/index.ts",
        "src/runtime.ts",
        "src/service-cli.ts",
        "src/eve-service-host.ts",
        "tests/**/*.ts",
        "agent/**/*.ts",
        "worker/*.mjs",
        "worker/*.ts",
        "fixtures/**/*.test.ts"
      ],
      "ignoreDependencies": ["workflow"]
    },
    "docs/examples/pi-eve-compatibility": {
      "entry": ["*.mjs", "worker/*.ts", "worker/*.mjs"],
      "ignoreDependencies": ["workflow", "typebox", "@earendil-works/pi-coding-agent"],
      "ignoreBinaries": ["pi"]
    }
  },
  "ignoreBinaries": ["noop"]
}
