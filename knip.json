{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "moonrepo": true,
  "entry": ["src/pages/**/*.mdx", "src/registry/kobalte/examples/**/*.tsx", "velite.config.ts"],
  "ignoreIssues": {
    ".velite/**": ["files", "exports", "types"],
    "src/registry/kobalte/**": ["files", "exports", "types"]
  },
  "ignoreExportsUsedInFile": true,
  "treatConfigHintsAsErrors": true
}
