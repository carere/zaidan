{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.mdx",
    "src/registry/kobalte/examples/**/*.tsx",
    "velite.config.ts",
    "tests/browser/*.fixture.tsx",
    "tests/browser/vite.config.ts"
  ],
  "ignoreIssues": {
    ".velite/**": ["files", "exports", "types"],
    "src/lib/types.ts": ["duplicates"],
    "src/registry/kobalte/**": ["files", "exports", "types"]
  },
  "ignoreExportsUsedInFile": true,
  "treatConfigHintsAsErrors": true
}
